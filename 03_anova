
tarwi2=read.delim("clipboard")
attach(tarwi2)
str(tarwi2)
summary(tarwi2)

PEG0=tarwi2[1:72,]
PEG1=tarwi2[73:144,]
PEG2=tarwi2[145:216,]
PEG3=tarwi2[217:288,]

mode1=aov(data =PEG0,IMB~T2)  #IMB: Imbibition rate, T2: imbibition hours
shapiro.test(residuals(mode1))  #normality
bartlett.test(data =PEG0,IMB~T2) #homogeneity of variances test
summary(mode1)
cv.model(mode1)
A1=duncan.test(mode1,"T2",console = TRUE) #Duncan's Multiple Range Test #significance of means

mode2=aov(data =PEG1,IMB~T2)
shapiro.test(residuals(mode2))
bartlett.test(data =PEG1,IMB~T2)
summary(mode2)
cv.model(mode2)
A1=duncan.test(mode2,"T2",console = TRUE)

