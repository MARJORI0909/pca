#Histograma del peso final y inicial  (para dos variables en espejo)

library(ggplot2)

library(hrbrthemes)

p <- ggplot(peg, aes(x=x) ) +
  geom_histogram( aes(x = Peso_inicial, y = ..density..), fill="#69b3a2" ) +
  geom_label( aes(x=2.5, y=0.25, label="Peso inicial (g)"), color="#69b3a2") +
  geom_histogram( aes(x = Peso_final , y = -..density..), fill= "#404080") +
  geom_label( aes(x=4.5, y=-0.25, label="Peso final (g)"), color="#404080") +
  theme_ipsum() +
  xlab("Peso 100 semillas (g) ")
p
