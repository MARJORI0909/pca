#Boxplot (cuadro por tratamiento  y variables x horas imbibicion)

library(agricolae)

library(car)

library(dplyr)

peg$Horas_imbibicion <- factor(peg$Horas_imbibicion, levels = c("h01","h02","h03","h04","h05","h06","h07","h08","h09",
                                                                "h10","h11","h12","h13","h14","h15","h16","h17","h18",
                                                                "h19","h20","h21","h22","h23","h24"))
PEG0<- select(filter(peg, PEG == "PEG0"	),c(Horas_imbibicion, rep, Peso_inicial,Peso_final,pH,CE,CRA,IMB))

PEG1<- select(filter(peg, PEG == "PEG1"	),c(Horas_imbibicion, rep, Peso_inicial,Peso_final,pH,CE,CRA,IMB))

PEG2<- select(filter(peg, PEG == "PEG2"	),c(Horas_imbibicion, rep, Peso_inicial,Peso_final,pH,CE,CRA,IMB))

PEG3<- select(filter(peg, PEG == "PEG3"	),c(Horas_imbibicion, rep, Peso_inicial,Peso_final,pH,CE,CRA,IMB))

{par(mfrow=c(1,4))
  
  boxplot(data=PEG0,PEG0$Peso_final~Horas_imbibicion, main = "PEG0", ylab = "Peso Turgente (g)",xlab="Horas de imbibici?n",col=c("yellow"))
  
  boxplot(data=PEG1,PEG1$Peso_final~Horas_imbibicion, main = "PEG1",ylab = "Peso Turgente (g)",xlab="Horas de imbibici?n",col=c("green") )
  
