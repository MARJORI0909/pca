#Initial analysis: Inferential

tarwi2<- read.delim("clipboard")
attach(tarwi2)
str(tarwi2)

# library

library(ggplot2)

# grouped boxplot 

ggplot(tarwi2, aes(x=T2, y=PF2, fill=PEG)) + 
  geom_boxplot() +   ggtitle("Fresh weight of 100 tarwi seeds according to imbibition hours and PEG concentration") +
  theme(plot.title = element_text(hjust = 0.5)) + xlab("Imbibition hours") + ylab("Fresh weight")

ggplot(tarwi2, aes(x=T2, y=PT2, fill=PEG)) + 
  geom_boxplot() +   ggtitle("Turgid weight of 100 tarwi seeds according to imbibition hours and PEG concentration") +
  theme(plot.title = element_text(hjust = 0.5)) + xlab("Imbibition hours") + ylab("Turgid weight (g)")

ggplot(tarwi2, aes(x=T2, y=pH2, fill=PEG)) + 
  geom_boxplot() +   ggtitle("pH of 100 tarwi seeds according to imbibition hours and PEG concentration") +
  theme(plot.title = element_text(hjust = 0.5)) + xlab("Imbibition hours") + ylab("pH")


ggplot(tarwi2, aes(x=T2, y=CE2, fill=PEG)) + 
  geom_boxplot() +   ggtitle("Electrical conductivity of 100 tarwi seeds according to imbibition hours and PEG concentration") +
  theme(plot.title = element_text(hjust = 0.5))+ xlab("Imbibition hours") + ylab("CE (mS/cm)")

ggplot(tarwi2, aes(x=T2, y=CRA2, fill=PEG)) + 
