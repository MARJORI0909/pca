  theme(plot.title = element_text(hjust = 0.5))+ xlab("Imbibition hours") + ylab("CRA (%)")

ggplot(tarwi2, aes(x=T2, y=IMB2, fill=PEG)) + 
  geom_boxplot() +   ggtitle("Imbibition rate(%) of 100 tarwi seeds according to imbibition hours and PEG concentration") +
  theme(plot.title = element_text(hjust = 0.5))+ xlab("Imbibition hours") + ylab("IMB (%)")


#Boxplot (Table by treatment and variables by hours of imbibition)

library(agricolae)

library(car)

library(dplyr)

tarwi2$T2<- factor(tarwi2$T2, levels = c("h01","h02","h03","h04","h05","h06","h07","h08","h09",
                                                                "h10","h11","h12","h13","h14","h15","h16","h17","h18",
                                                                "h19","h20","h21","h22","h23","h24"))
PEG0<- select(filter(peg, PEG == "PEG0"	),c(T2, rep, PF2,PT2,pH2,CE2,CRA2,IMB2))

PEG1<- select(filter(peg, PEG == "PEG1"	),c(T2, rep, PF2,PT2,pH2,CE2,CRA2,IMB2))

PEG2<- select(filter(peg, PEG == "PEG2"	),c(T2, rep, PF2,PT2,pH2,CE2,CRA2,IMB2))

PEG3<- select(filter(peg, PEG == "PEG3"	),c(T2, rep, PF2,PT2,pH2,CE2,CRA2,IMB2))

{par(mfrow=c(1,4))
  
  boxplot(data=PEG0,PEG0$PT2~T2, main = "PEG0", ylab = "Turgid weight (g)",xlab="Imbibition hours",col=c("yellow"))
  
  boxplot(data=PEG1,PEG1$PT2~T2, main = "PEG1",ylab = "Turgid weight (g)",xlab="Imbibition hours",col=c("green") )
  
  boxplot(data=PEG2,PEG2$PT2~T2, main = "PEG2",ylab = "Turgid weight (g)",xlab="Imbibition hours",col=c("red"))
  
  boxplot(data=PEG3,PEG3$PT2~T2, main = "PEG3",ylab = "Turgid weight (g)",xlab="Imbibition hours",col=c("blue"))
  
  mtext("Boxplot of the Turgid Weight of 100 tarwi seeds according to PEG concentration and hours of imbibition",
        side = 3, line = -1.2, outer = TRUE, font = 2 )
}

{par(mfrow=c(1,4))
  
  boxplot(data=PEG0,PEG0$pH2~T2, main = "PEG0", ylab = "pH",xlab="Imbibition hours",col=c("yellow"))
  
